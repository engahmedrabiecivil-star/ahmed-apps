{
  "name": "concrete-spc",
  "productName": "Concrete SPC",
  "version": "1.1.0",
  "description": "Concrete SPC - 28-day cube strength statistical analysis (ECP 203-2020)",
  "author": "Eng. Ahmed Rabie",
  "main": "main.js",
  "build": {
    "appId": "com.ahmedrabie.concretespc",
    "productName": "Concrete SPC",
    "files": ["main.js", "preload.js", "icon.png", "app/**"],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Concrete SPC",
      "artifactName": "Concrete-SPC-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  }
}
